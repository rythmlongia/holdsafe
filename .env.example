# --- PayPal (sandbox) --------------------------------------------------------
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to run in simulated-PayPal mode (same API shapes, no network).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id from the dashboard, for verified webhook delivery
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
CURRENCY=USD

# --- AI provider (set ONE key; leave all blank for the offline heuristic engine)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# AI_PROVIDER=anthropic   # force a provider: anthropic | openai | gemini | heuristic

# --- App ---------------------------------------------------------------------
PORT=3000
BASE_URL=http://localhost:3000
# Signs capability tokens + the audit ledger. Generated and saved to data/ if blank.
APP_SECRET=

# --- Policy guardrails ---------------------------------------------------------
POLICY_MAX_DEAL=5000
POLICY_AUTO_RELEASE_MAX=500
POLICY_AUTO_RELEASE_MIN_CONF=0.85
POLICY_MAX_RISK=75
POLICY_DAILY_BUYER_LIMIT=10000
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_AI_PER_MIN=20
